generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}



model Visitor {
  id        String   @id @default(uuid())
  date      DateTime @unique @default(now()) @db.Date // Simpan tanggal saja tanpa jam
  count     Int      @default(0)                      // Jumlah kunjungan hari itu
}
